{
  "name": "@sanity/bifur-client",
  "version": "2.0.2",
  "description": "WebSocket client for Sanity's Bifur real-time service, communicating over JSON-RPC 2.0 and returning RxJS Observables",
  "keywords": [
    "bifur",
    "json-rpc",
    "observables",
    "presence",
    "real-time",
    "realtime",
    "rxjs",
    "sanity",
    "sanity-io",
    "websocket"
  ],
  "homepage": "https://github.com/sanity-io/bifur-client#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/bifur-client/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/bifur-client.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "nanoid": "^6.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@sanity/pkg-utils": "^12.2.0",
    "@sanity/tsconfig": "^2.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rx": "^5.1.1",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "node >=22.12",
    "baseline 2024"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run pkg:build && pnpm run pkg:check",
    "clean": "rimraf dist",
    "format": "oxfmt && pnpm lint --fix",
    "knip": "knip --no-config-hints",
    "lint": "oxlint",
    "pkg:build": "pkg build --strict",
    "pkg:check": "pkg check --strict",
    "release": "changeset publish",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "watch": "pkg build --strict --watch"
  }
}