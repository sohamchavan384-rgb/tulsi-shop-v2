{
  "name": "@sanity/workflow-cli",
  "version": "0.32.0",
  "description": "Command-line tool for deploying, inspecting, and administering Sanity workflow definitions and instances.",
  "keywords": [
    "cli",
    "oclif",
    "sanity",
    "sanity-io",
    "workflow",
    "workflows"
  ],
  "homepage": "https://github.com/sanity-io/workflows/tree/main/packages/workflow-cli#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/workflows/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/workflows.git",
    "directory": "packages/workflow-cli"
  },
  "bin": {
    "sanity-workflows": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin/run.js",
    "oclif.manifest.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oclif/core": "^4.11.4",
    "@oclif/plugin-help": "^6.2.50",
    "@sanity/client": "^7.22.1",
    "@sanity/telemetry": "^1.1.0",
    "boxen": "^8.0.1",
    "diff": "^9.0.0",
    "jiti": "^2.7.0",
    "log-symbols": "^7.0.1",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@sanity/cli-core": "^3.6.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.12.4",
    "oclif": "^4.23.16",
    "vitest": "^4.1.8",
    "@sanity/workflow-engine": "0.32.0",
    "@sanity/workflow-engine-test": "0.32.0",
    "@sanity/workflow-examples": "0.12.0"
  },
  "peerDependencies": {
    "@sanity/cli-core": "^3.6.0",
    "@sanity/workflow-engine": "0.32.0"
  },
  "oclif": {
    "bin": "sanity-workflows",
    "commands": "./dist/commands",
    "dirname": "sanity-workflows",
    "helpClass": "./dist/help",
    "hooks": {
      "finally": "./dist/hooks/finally/telemetry",
      "prerun": "./dist/hooks/prerun/telemetry"
    },
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "workflows": {
        "description": "Deploy, inspect, and administer Workflows definitions and instances",
        "subtopics": {
          "definition": {
            "description": "Read and manage workflow definitions"
          }
        }
      }
    }
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.declarations.json",
    "docs": "node ../../scripts/run-typedoc.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:packaging": "vitest run --config vitest.packaging.config.ts",
    "test:watch": "vitest",
    "dev": "NODE_OPTIONS='--conditions=development' tsx --env-file-if-exists=../../.env bin/dev.js",
    "cli": "NODE_OPTIONS='--conditions=development' tsx --env-file-if-exists=../../.env bin/dev.js"
  }
}