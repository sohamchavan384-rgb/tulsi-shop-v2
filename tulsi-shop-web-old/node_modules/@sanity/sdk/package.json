{
  "name": "@sanity/sdk",
  "version": "3.3.0",
  "private": false,
  "description": "Sanity SDK",
  "keywords": [
    "cms",
    "content",
    "content operating system",
    "headless",
    "realtime",
    "sanity",
    "sdk"
  ],
  "homepage": "https://github.com/sanity-io/sdk/tree/main/packages/core/README.md",
  "bugs": {
    "url": "https://github.com/sanity-io/sdk/issues"
  },
  "license": "MIT",
  "author": "Sanity <developers@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/sdk.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./_internal": "./dist/_exports/_internal.js",
    "./agent": "./dist/_exports/agent.js",
    "./comlink": "./dist/_exports/comlink.js",
    "./dashboard": "./dist/_exports/dashboard.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sanity/bifur-client": "^1.0.0",
    "@sanity/client": "^8.6.2",
    "@sanity/comlink": "^4.0.3",
    "@sanity/diff-match-patch": "^3.2.0",
    "@sanity/diff-patch": "^6.0.0",
    "@sanity/id-utils": "^1.1.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/json-match": "^1.0.5",
    "@sanity/message-protocol": "^0.24.0",
    "@sanity/mutate": "^0.18.2",
    "@sanity/telemetry": "^1.1.0",
    "@sanity/types": "^6.14.1",
    "groq": "^6.13.2",
    "groq-js": "^2.0.0",
    "reselect": "^5.1.1",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@repo/config-eslint": "0.0.0",
    "@repo/config-test": "0.0.1",
    "@repo/package.bundle": "3.82.0",
    "@repo/package.config": "0.0.1",
    "@repo/tsconfig": "0.0.1",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^13.0.0",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "oxfmt": "^0.68.0",
    "rolldown": "^1.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "scripts": {
    "build": "pkg build --strict --clean --check",
    "build:bundle": "vite build --configLoader runner --config package.bundle.ts",
    "clean": "rimraf dist",
    "dev": "pkg watch",
    "docs": "typedoc --json docs/typedoc.json --tsconfig ./tsconfig.dist.json",
    "format": "oxfmt",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ts:check": "tsc --noEmit"
  }
}