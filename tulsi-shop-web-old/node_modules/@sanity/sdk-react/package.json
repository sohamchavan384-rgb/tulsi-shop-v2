{
  "name": "@sanity/sdk-react",
  "version": "3.3.0",
  "private": false,
  "description": "Sanity SDK React toolkit for Content OS",
  "keywords": [
    "cms",
    "content",
    "content operating system",
    "headless",
    "realtime",
    "sanity",
    "sdk"
  ],
  "homepage": "https://github.com/sanity-io/sdk/tree/main/packages/react/README.md",
  "bugs": {
    "url": "https://github.com/sanity-io/sdk/issues"
  },
  "license": "MIT",
  "author": "Sanity <developers@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/sdk.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./dashboard": "./dist/_exports/dashboard.js",
    "./dashboard/_internal": "./dist/_exports/dashboard-internal.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@module-federation/runtime": "^2.9.0",
    "@sanity/client": "^8.6.2",
    "@sanity/message-protocol": "^0.24.0",
    "@sanity/sdk": "3.3.0",
    "@sanity/types": "^6.14.1",
    "react-compiler-runtime": "^1.0.0",
    "react-error-boundary": "^6.1.5",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@repo/config-eslint": "0.0.0",
    "@repo/config-test": "0.0.1",
    "@repo/package.bundle": "3.82.0",
    "@repo/package.config": "0.0.1",
    "@repo/tsconfig": "0.0.1",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/comlink": "^4.0.3",
    "@sanity/pkg-utils": "^13.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "groq": "^6.13.2",
    "groq-js": "^2.0.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.68.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "^1.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "xstate": "5.32.6"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "inlinedDependencies": {
    "@sanity/comlink": "4.0.3",
    "xstate": "5.32.6"
  },
  "scripts": {
    "build": "pkg build --strict --clean --check",
    "build:bundle": "vite build --configLoader runner --config package.bundle.ts",
    "clean": "rimraf dist",
    "dev": "pkg watch",
    "docs": "typedoc --json docs/typedoc.json --tsconfig ./tsconfig.dist.json",
    "format": "oxfmt",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ts:check": "tsc --noEmit"
  }
}